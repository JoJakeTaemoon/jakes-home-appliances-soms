# Seoul Aqua SOMS — reverse proxy.
#
# One host serves every realm: the customer portal at `/`, the office app at
# `/o` and the field app at `/f`. There is no separate portal deployment, so
# `soms.seoulaqua.com.vn` is the only name this server answers for.
#
# Caddy issues and renews the certificate from Let's Encrypt on its own. That
# needs port 80 reachable from the internet for the challenge, and the A
# record already pointing here — a swap done in the other order burns failed
# issuance attempts against the rate limit.

{
	admin off
}

soms.seoulaqua.com.vn {
	# Larger body limit so visit photos and SR attachments (~5-10 MB) succeed.
	request_body {
		max_size 20MB
	}

	# Same-origin defaults that don't break next-intl locale routing.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Compress everything text-y. Images/PDFs are already compressed upstream.
	encode zstd gzip

	reverse_proxy app:3000 {
		# Pass through real client IP + protocol so Next.js logs are useful.
		header_up X-Real-IP {remote_host}
	}
}

# No `:80` site block here on purpose. Caddy adds the HTTP-to-HTTPS redirect
# for a named site by itself, and a catch-all `:80` would sit in front of the
# ACME challenge it serves on that port.

// Seoul Aqua SOMS — Prisma schema
// Generated 2026-05-27 for Phase 1-7 local-first implementation.
// Source: docs/DATA_MODEL_NOTES.md + docs/SPEC.md + docs/PRD.md.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// AUTH & USERS (Phase 1)
// ─────────────────────────────────────────────────────────────────────────

enum StaffRole {
  ADMIN
  MANAGER
  STAFF
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                         String     @id @default(cuid())
  // Phone is the login key for every staff role (admin/manager/staff/technician).
  // username is a free-form display label (e.g. "admin", "Nguyễn Văn A") — not unique.
  username                   String
  phone                      String     @unique
  email                      String?
  passwordHash               String
  role                       StaffRole
  status                     UserStatus @default(ACTIVE)
  preferredRegion            String? // scheduler input
  mustChangePassword         Boolean    @default(false)
  /// True when this user is a candidate in the sales-rep selector. Set by
  /// ADMIN. Independent from `role` so a STAFF or MANAGER can be marked as
  /// sales rep, while TECHNICIAN/ADMIN are never picked.
  isSalesRep                 Boolean    @default(false)
  /// Display title shown next to the user's name on customer-detail headers,
  /// table avatars, and SMS signatures (e.g. "구매팀 차장", "본인").
  title                      String?
  /// Avatar image URL (Vercel Blob / Gravatar / fallback initials).
  avatarUrl                  String?
  lastLoginAt                DateTime?
  failedLoginCount           Int        @default(0)
  lockedUntil                DateTime?
  // Self-service password recovery (SMS verification → temp password).
  passwordResetCodeHash      String?
  passwordResetCodeExpiresAt DateTime?
  passwordResetAttempts      Int        @default(0)
  passwordResetLastRequestAt DateTime?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  sessions             Session[]
  leadVisits           Visit[]        @relation("LeadTechnician")
  auditActions         AuditLog[]     @relation("ActorUser")
  collectedPayments    Payment[]
  loginAttempts        LoginAttempt[]
  preferredByCustomers Customer[]     @relation("PreferredTech")
  assignedCustomers    Customer[]     @relation("CustomerSalesRep")
  registeredEquipment  Equipment[]    @relation("EquipmentRegisteredBy")
  createdOrders        Order[]        @relation("OrderCreatedBy")
  stockMoves           StockMove[]    @relation("StockMoveCreatedBy")

  @@index([role, status])
  @@index([isSalesRep])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id          String   @id @default(cuid())
  username    String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress   String?
  userAgent   String?
  success     Boolean
  attemptedAt DateTime @default(now())

  @@index([username, attemptedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// AUDIT LOG (Phase 1+)
// ─────────────────────────────────────────────────────────────────────────

enum ActorType {
  USER // staff
  CUSTOMER // portal account
  SYSTEM // cron / scheduler
}

model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  actorUser  User?     @relation("ActorUser", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "CUSTOMER_CREATE", "CONTRACT_AMEND"
  entityType String // e.g. "Customer", "Contract"
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  at         DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([at])
  @@index([action])
}

// ─────────────────────────────────────────────────────────────────────────
// CUSTOMER + SITE + CONTACT (Phase 2)
// ─────────────────────────────────────────────────────────────────────────

enum CustomerType {
  B2C
  B2B
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

/// B2C-only legal-identity discriminator. DOMESTIC ties to a Vietnamese
/// national ID (CCCD); FOREIGN ties to a passport + nationality pair.
enum CustomerResidency {
  DOMESTIC
  FOREIGN
}

enum ContactRole {
  CONTRACT_PARTY
  OPS_CONTACT
}

enum ContactScope {
  CUSTOMER // organization-level (always for CONTRACT_PARTY)
  SITE // site-specific (OPS_CONTACT only)
}

enum Locale {
  ko
  vi
  en
}

model Customer {
  id         String         @id @default(cuid())
  code       String         @unique // KH#####
  legacyCode String?        @unique // pre-migration code (A.2)
  type       CustomerType
  status     CustomerStatus @default(ACTIVE)

  // B2C: just name; B2B: legal entity name
  name      String
  shortcode String? @unique // B2B 2-5 letter; used in contract code (B.2)
  taxCode   String? // B2B Vietnamese tax code (MST)

  // ── Legal-identity block (required for contract issuance) ───────────────
  /// B2C only: DOMESTIC or FOREIGN. Optional — neither CCCD nor passport is
  /// required at creation (collected later when the contract is issued).
  /// Ignored for B2B (which uses CONTRACT_PARTY contact as the signatory).
  residency          CustomerResidency? @default(DOMESTIC)
  /// B2C DOMESTIC: Vietnamese national ID (CCCD / Căn cước công dân). Optional.
  nationalId         String?
  /// B2C FOREIGN: passport number. Optional.
  passportNumber     String?
  /// B2C FOREIGN: ISO country name (e.g. "Korea", "Japan"). Optional.
  nationality        String?
  /// Issue date for whichever identity document (CCCD or passport) is on file.
  documentIssueDate  DateTime?
  /// Issue place for the identity document. Free-text (e.g. "Cục Cảnh sát QLHC ĐKQG").
  documentIssuePlace String?

  // Primary address — Shopee VN style. Post-2025 reform (district level
  // abolished) this is 2-tier: province → ward + street.
  // Legacy `address/district/city` kept nullable for back-compat read-only display.
  addressProvinceCode String?
  addressProvinceName String?
  addressWardCode     String?
  addressWardName     String?
  addressStreet       String?
  /// @deprecated Use addressStreet. Populated for legacy rows only.
  address             String?
  /// @deprecated Middle address line. Now denormalizes addressWardName (the
  /// sub-province unit after the 2025 district abolition); old rows hold a district.
  district            String?
  /// @deprecated Use addressProvinceName. Populated for legacy rows only.
  city                String?

  preferredTechnicianId String?
  preferredTechnician   User?   @relation("PreferredTech", fields: [preferredTechnicianId], references: [id], onDelete: SetNull, map: "Customer_preferredTechnicianId_fkey")
  preferredRegion       String? // soft hint for scheduler (C.2)

  /// Sales rep (담당 판매원) — User with isSalesRep=true. Used in the customer
  /// list "담당 판매원" column and the sales-rep menu's per-rep aggregations
  /// (new contracts / receivables by period).
  salesRepId String?
  salesRep   User?   @relation("CustomerSalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)

  notes String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deactivatedAt      DateTime?
  deactivationReason String?

  sites            Site[]
  contacts         CustomerContact[]
  equipment        Equipment[]
  contracts        Contract[]
  orders           Order[]
  serviceRequests  ServiceRequest[]
  visits           Visit[]
  payments         Payment[]
  notificationLogs NotificationLog[]
  documents        Document[]

  @@index([code])
  @@index([type, status])
  @@index([shortcode])
  @@index([salesRepId])
}

model Site {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String // e.g. "본사 사옥", "지점 1"

  // Structured address (Shopee VN style, 2-tier post-2025 reform). All optional
  // — legacy rows may carry only `address` until migrated.
  addressProvinceCode String?
  addressProvinceName String?
  addressWardCode     String?
  addressWardName     String?
  addressStreet       String?
  /// @deprecated Use addressStreet.
  address             String?
  /// @deprecated Middle address line. Now denormalizes addressWardName.
  district            String?
  /// @deprecated Use addressProvinceName.
  city                String?
  region              String? // scheduler input
  notes               String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  contacts        CustomerContact[]
  equipment       Equipment[]
  visits          Visit[]
  serviceRequests ServiceRequest[]
  orders          Order[]

  @@index([customerId])
  @@index([region])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  siteId     String?
  site       Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  role                ContactRole
  scope               ContactScope @default(CUSTOMER)
  isPrimary           Boolean      @default(false) // exactly one primary OPS per customer (or per site)
  isAccountingContact Boolean      @default(false) // at most one accounting OPS per customer (CUSTOMER scope) — receives tax invoices / accounting comms

  name     String
  title    String? // e.g. "관리부장", "Mrs."
  phone1   String // primary phone (login key for portal)
  phone2   String?
  email    String?
  language Locale  @default(vi)

  // Portal account
  portalEnabled      Boolean   @default(false)
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?

  // Opt-outs (F.3)
  smsOptOut   Boolean @default(false)
  emailOptOut Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerSessions CustomerSession[]
  serviceRequests  ServiceRequest[]
  notificationLogs NotificationLog[]

  @@index([customerId, role])
  @@index([siteId])
  @@index([phone1])
}

model CustomerSession {
  id           String          @id @default(cuid())
  contactId    String
  contact      CustomerContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  refreshToken String          @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime        @default(now())

  @@index([contactId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────
// EQUIPMENT (Phase 2-3)
// ─────────────────────────────────────────────────────────────────────────

enum EquipmentCategory {
  WATER_PURIFIER
  BIDET
  AIR_PURIFIER
  FILTER
  OTHER
}

enum EquipmentStatus {
  ACTIVE
  REPLACED // replaced by another unit (legacy retained)
  RELOCATED
  DEACTIVATED // customer cancelled (A.3 — lifecycle preserved, no delete)
  TERMINATED // contract terminated
}

/// Per-equipment service shape — decoupled from Contract.type so equipment can
/// exist without a contract (e.g. SELF_MANAGED inspection-only units, or a
/// SALE delivered without a maintenance contract).
enum EquipmentServiceType {
  RENTAL
  MAINTENANCE
  SALE
}

/// Per-equipment management shape — whether Seoul Aqua provides full service
/// (FULL_SERVICE: inspection + filter swaps included) or the customer manages
/// it themselves (SELF_MANAGED: we just push filter-due alerts).
enum ManagementType {
  FULL_SERVICE
  SELF_MANAGED
  OTHER
}

/// Equipment lifecycle stage — independent from any Contract. Drives the
/// "운영 중 / 정지" badge in the customer-detail equipment list, monthly
/// revenue aggregation, and the rental-to-maintenance auto-transition.
enum LifecycleStage {
  INSTALLED // freshly registered, INSTALLATION visit pending
  IN_RENTAL // rental term active
  IN_MAINTENANCE // out of rental, on maintenance / standalone-managed
  RETRIEVED // device physically returned to Seoul Aqua
  REPLACED // replaced by another row
}

enum EquipmentOwnership {
  COMPANY // rental — owned by Seoul Aqua
  CUSTOMER // sold or post-rental transfer (B.3)
}

// ProductCategory — multilingual catalog category (replaces the
// EquipmentCategory enum). `code` keeps a stable identifier for code paths
// that still rely on the enum semantics (WATER_PURIFIER, BIDET, AIR_PURIFIER,
// FILTER, OTHER) during the transition.
model ProductCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  nameKo    String
  nameVi    String
  nameEn    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models      EquipmentModel[]
  consumables Consumable[]

  @@index([isActive, sortOrder])
}

// Brand — distinct manufacturer/marketer of equipment models. Single name
// field for now; future work will add brand-level sales/billing rollups.
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models      EquipmentModel[]
  consumables Consumable[]

  @@index([isActive, sortOrder])
}

model EquipmentModel {
  id                      String             @id @default(cuid())
  /// Legacy SKU-like identifier. UI no longer surfaces this field; new rows
  /// may leave it null. Kept on the table for back-compat with existing data.
  /// NULL is allowed (Postgres permits multiple NULL rows under @unique).
  modelCode               String?            @unique
  // Customer-facing product names in KO/VI/EN. The model code itself
  // stays single-language (alphanumeric/symbol). The previous single-language
  // `name` column was dropped — UI / API now picks the locale-appropriate
  // value via `pickModelName(model, locale)` from `src/lib/products/name.ts`.
  nameKo                  String?
  nameVi                  String?
  nameEn                  String?
  brandId                 String?
  brand                   Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  // Legacy enum classification — kept during the ProductCategory rollout so
  // existing list filters & seeded code paths keep working. Prefer `categoryId`.
  category                EquipmentCategory?
  categoryId              String?
  productCategory         ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description             String?
  filterPolicy            Json? // legacy: { filters: [{type, replaceEveryDays}, ...] } — use Consumable instead
  retailPrice             Decimal?           @db.Decimal(14, 2) // 소비자가 (Giá bán lẻ)
  // 판매가 (Giá bán) — mockup shows this alongside 소비자가; kept distinct so
  // list price and actual sale price can differ. Nullable; UI falls back to retailPrice.
  salePrice               Decimal?           @db.Decimal(14, 2)
  // 입고가 (Giá nhập) — purchase/inbound unit cost.
  purchasePrice           Decimal?           @db.Decimal(14, 2)
  // 지정가 (Giá tại đại lý) — dealer/agency price.
  fixedPrice              Decimal?           @db.Decimal(14, 2)
  monthlyRentalPrice      Decimal?           @db.Decimal(14, 2)
  monthlyMaintenancePrice Decimal?           @db.Decimal(14, 2)
  // Inventory — cached on-hand counter (StockMove ledger is history-of-record)
  // and low-stock threshold. Negative on-hand is allowed (alert, not a block).
  stockOnHand             Int                @default(0)
  safetyStock             Int                @default(0)
  // Periodic inspection cycle (days). 30 for water purifiers (PDF A.2).
  inspectionEveryDays     Int?
  // Warranty months for SALE customers — used by charge-policy default rules.
  warrantyMonths          Int?               @default(12)
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  equipment   Equipment[]
  consumables ConsumableOnModel[]
  accessories AccessoryOnModel[]
  orderItems  OrderItem[]
  stockMoves  StockMove[]         @relation("StockMoveModel")

  @@index([category, isActive])
  @@index([categoryId, isActive])
  @@index([brandId, isActive])
}

// Catalog of replaceable/cleanable parts attached to an equipment model.
// A consumable can carry both a replacement cycle and a cleaning cycle
// (e.g. RO membrane: clean every 6 months, replace every 24 months).
// At least one of replaceEveryDays/cleanEveryDays must be non-null —
// enforced in Zod (see src/lib/validators/product.ts).
/// How a filter's replace cycle was entered in the Filter Master — days or
/// months. The canonical stored value stays `replaceEveryDays` (days;
/// months × 30) so all day-based next-due math is unaffected; this only
/// drives the input/display unit.
enum ConsumableCycleUnit {
  DAY
  MONTH
}

model Consumable {
  id                String              @id @default(cuid())
  sku               String              @unique
  nameKo            String
  nameVi            String
  nameEn            String
  replaceEveryDays  Int?
  /// Input/display unit for replaceEveryDays (canonical storage stays days).
  replaceCycleUnit  ConsumableCycleUnit @default(DAY)
  cleanEveryDays    Int?
  // PDF A.4: pre-filters are cleaned on every periodic-inspection visit
  // (no fixed month-based cycle). When true, recommender prefills CLEAN
  // on every PERIODIC_INSPECTION visit regardless of cycle math.
  cleanOnEveryVisit Boolean             @default(false)
  // Product classification — mirrors EquipmentModel so the filter master can
  // carry its own 제품그룹 (category) + 브랜드 (brand), independent of which
  // models it attaches to. Nullable; FK set-null on delete.
  categoryId        String?
  productCategory   ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId           String?
  brand             Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  spec              String? // 규격 (Quy cách) — e.g. "9 inch", "14 W"
  mainUse           String? // 주요용도 (Công dụng chính)
  retailPrice       Decimal             @db.Decimal(14, 2) // 소비자가
  // 입고가 / 지정가 — same semantics as EquipmentModel.
  purchasePrice     Decimal?            @db.Decimal(14, 2)
  fixedPrice        Decimal?            @db.Decimal(14, 2)
  // Inventory — see EquipmentModel. Negative on-hand allowed (alert, not block).
  stockOnHand       Int                 @default(0)
  safetyStock       Int                 @default(0)
  notes             String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  compatibleModels ConsumableOnModel[]
  visitLogs        VisitConsumableLog[]
  chargePolicies   ChargePolicy[]
  equipmentLinks   EquipmentConsumable[]
  orderItems       OrderItem[]
  stockMoves       StockMove[]           @relation("StockMoveConsumable")

  @@index([isActive])
  @@index([categoryId, isActive])
  @@index([brandId, isActive])
}

// Non-cyclical attachments (mounts, adapters, hoses…) sold or replaced
// on demand. No replacement cycle, just a sale price + compatibility.
model Accessory {
  id          String   @id @default(cuid())
  sku         String   @unique
  nameKo      String
  nameVi      String
  nameEn      String
  // PDF C.2 — small parts (cocks, valves, hoses, fittings) are still free
  // for MAINTENANCE customers, while larger parts (compressor, hot-water
  // tank, PCB…) are billed. Feeds the default charge-policy rule.
  isMinorPart Boolean  @default(false)
  retailPrice Decimal  @db.Decimal(14, 2)
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  compatibleModels AccessoryOnModel[]
  chargePolicies   ChargePolicy[]

  @@index([isActive])
}

model ConsumableOnModel {
  consumableId             String
  modelId                  String
  // PDF A.1 — most models hold 1 of each filter, oversize units carry 2.
  quantity                 Int            @default(1)
  /// User-chosen filter order within a model's filter config (요청 A.4).
  sortOrder                Int            @default(0)
  /// Per-model replace-cycle override (days). When null the filter's own
  /// `Consumable.replaceEveryDays` applies. Precedence for a unit:
  /// EquipmentConsumable.replaceEveryDays > this > Consumable.replaceEveryDays.
  replaceEveryDaysOverride Int?
  consumable               Consumable     @relation(fields: [consumableId], references: [id], onDelete: Cascade)
  model                    EquipmentModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([consumableId, modelId])
  @@index([modelId])
}

model AccessoryOnModel {
  accessoryId String
  modelId     String
  quantity    Int            @default(1)
  accessory   Accessory      @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  model       EquipmentModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([accessoryId, modelId])
  @@index([modelId])
}

// Contract types used by ChargePolicy. Distinct from `ContractType` so the
// charge matrix isn't coupled to other contract domain changes.
enum ChargePolicyContractType {
  RENTAL
  SALE
  MAINTENANCE
}

// Exception rules for billing parts. The default rule lives in code
// (`src/lib/charge-policy.ts`):
//   RENTAL                → free
//   SALE  + withinWarranty → free
//   SALE  + after warranty → charged
//   MAINTENANCE + minor    → free (accessories only — small parts)
//   MAINTENANCE + major    → charged
// Anything else (consumables under MAINTENANCE, etc.) follows the SALE rule.
// Rows in this table override the default for one specific
// (part, contractType, withinWarranty) tuple.
model ChargePolicy {
  id             String                   @id @default(cuid())
  accessoryId    String?
  consumableId   String?
  contractType   ChargePolicyContractType
  // SALE only — for RENTAL/MAINTENANCE this is stored as `false` so the
  // unique index still works without conditional uniqueness.
  withinWarranty Boolean                  @default(false)
  isChargeable   Boolean
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  accessory      Accessory?               @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  consumable     Consumable?              @relation(fields: [consumableId], references: [id], onDelete: Cascade)

  @@unique([accessoryId, contractType, withinWarranty])
  @@unique([consumableId, contractType, withinWarranty])
  @@index([accessoryId])
  @@index([consumableId])
}

// Discrete action: at recommendation/log time we always know whether a
// consumable touch was a replacement or a cleaning. Not stored on the
// Consumable row itself (a single row can carry both cycles).
enum ConsumableAction {
  REPLACE
  CLEAN
}

// Normalized record of consumable work performed during a Visit.
// Coexists with Visit.partsReplaced (legacy free-text JSON) during the
// gradual migration; new code reads from here.
model VisitConsumableLog {
  id           String           @id @default(cuid())
  visitId      String
  consumableId String
  action       ConsumableAction
  notes        String?
  createdAt    DateTime         @default(now())
  visit        Visit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  consumable   Consumable       @relation(fields: [consumableId], references: [id], onDelete: Restrict)

  @@index([visitId])
  @@index([consumableId, action, createdAt])
}

model Equipment {
  id                         String             @id @default(cuid())
  customerId                 String
  customer                   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  siteId                     String?
  site                       Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)
  /// Optional since 2026-06: MAINTENANCE contracts can register a customer's
  /// externally-purchased (off-catalog) device with no EquipmentModel — see
  /// `customDescription` + `customMaintenanceCycleDays` below.
  modelId                    String?
  model                      EquipmentModel?    @relation(fields: [modelId], references: [id])
  /// Free-text description of the device when modelId is null
  /// (e.g. "타사 정수기 모델 XYZ"). Required when modelId is null —
  /// enforced at the validator layer.
  customDescription          String?            @db.VarChar(500)
  /// Periodic inspection cycle in days for external equipment. Used by the
  /// scheduler when EquipmentModel.inspectionEveryDays is unavailable.
  customMaintenanceCycleDays Int?
  serialNumber               String?
  status                     EquipmentStatus    @default(ACTIVE)
  ownership                  EquipmentOwnership @default(COMPANY)
  installedAt                DateTime?
  installedByTechnicianId    String?
  /// Effective deactivation moment chosen by office staff. Past dates
  /// are allowed (back-dated DEACTIVATE) and feed the per-equipment
  /// pause ledger. Null while ACTIVE / never deactivated.
  deactivatedAt              DateTime?
  /// Effective termination moment chosen by office staff. Past dates
  /// are allowed. Independent from `retrievedAt` — termination decides
  /// "no more billing"; retrieval records when the physical device
  /// actually came back.
  terminatedAt               DateTime?
  /// Date the device was physically retrieved. Set only AFTER the unit
  /// is in TERMINATED state. Past dates allowed (the retrieval often
  /// happens in the field and is logged later).
  retrievedAt                DateTime?
  filterPolicyOverride       Json? // per-unit override
  replacedByEquipmentId      String?            @unique
  notes                      String?

  // ── Equipment-centric domain shift (added 2026-06) ────────────────────
  // Pricing + service identity belongs to the device, not the contract.
  // Contract.deposit/monthlyMaintenanceFee continue to exist as SUM caches
  // (refreshed by src/lib/contracts/recalculate-cache.ts).
  /// Per-unit deposit (refundable). Required when serviceType=RENTAL.
  deposit                   Decimal?              @db.Decimal(14, 2)
  /// Per-unit monthly fee (rental fee for RENTAL, maintenance fee for
  /// MAINTENANCE, null for SALE).
  monthlyFee                Decimal?              @db.Decimal(14, 2)
  /// Per-unit install fee (SALE). Independent from monthlyFee/deposit.
  installFee                Decimal?              @db.Decimal(14, 2)
  /// Per-unit sale price (SALE). monthlyFee stays rental/maintenance-only.
  salePrice                 Decimal?              @db.Decimal(14, 2)
  /// Per-unit service shape (RENTAL / MAINTENANCE / SALE). Independent
  /// from any linked Contract.type; equipment can exist without a contract.
  serviceType               EquipmentServiceType?
  /// FULL_SERVICE (we manage inspections + filters) vs SELF_MANAGED
  /// (customer manages; we only alert on filter-due) vs OTHER.
  managementType            ManagementType?
  /// Lifecycle stage decoupled from Contract.state — defaults to INSTALLED
  /// at registration, transitions IN_RENTAL while a RENTAL contract is
  /// active, then IN_MAINTENANCE on natural end-of-term (or RETRIEVED for
  /// retrieval contracts).
  lifecycleStage            LifecycleStage        @default(INSTALLED)
  /// Per-unit inspection cycle override (days). Falls back to
  /// model.inspectionEveryDays when null.
  customInspectionCycleDays Int?
  /// Admin override for "최근 점검일" (last inspection date). Normally the
  /// last inspection is derived from the latest completed PERIODIC_INSPECTION
  /// visit; this lets MANAGER+ correct an input error or seed pre-system
  /// history without a fake visit. When set it becomes the next-due anchor.
  lastInspectionAtOverride  DateTime?
  /// Admin override for "다음 예정 점검일". Normally derived (anchor + cycle);
  /// when set it takes precedence and drives the D-day directly, so staff can
  /// pin a specific next inspection date. Inline-editable in the service table.
  nextInspectionAtOverride  DateTime?
  /// Optional per-unit image (Vercel Blob). Falls back to model.imageUrl.
  imageUrl                  String?
  /// Office user who registered this unit (the staff member who ran the
  /// bulk-register wizard). Distinct from `installedByTechnicianId` which
  /// is the field technician who physically installs.
  registeredById            String?
  registeredBy              User?                 @relation("EquipmentRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  /// Optional asset code (자산 코드) — internal inventory identifier used
  /// during bulk installation (e.g. WA260501001). Distinct from serial.
  assetCode                 String?               @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts       ContractEquipment[]
  visits          Visit[]
  serviceRequests ServiceRequest[]
  payments        Payment[]
  consumables     EquipmentConsumable[]
  orders          Order[]
  /// Order lines tied to this specific unit (per-item "linked
  /// equipment" from the order-create modal). Sibling to `orders`
  /// (which is the whole-order link via `Order.equipmentId`).
  orderItems      OrderItem[]           @relation("OrderItemEquipment")

  @@index([customerId, status])
  @@index([siteId])
  @@index([modelId])
  @@index([serialNumber])
  @@index([assetCode])
  @@index([serviceType, lifecycleStage])
  @@index([managementType])
}

// ─────────────────────────────────────────────────────────────────────────
// ORDERS / 주문 (added 2026-06) — feeds Customer-detail "구매 이력" +
// "주문 내역(판매)" tabs and the per-equipment 구매 이력 widget. Distinct
// from Payment (post-installation cash flow) — Order is the pre-cash
// purchase document.
// ─────────────────────────────────────────────────────────────────────────

enum OrderState {
  PENDING // created, awaiting delivery
  DELIVERED // physically delivered
  CANCELLED
}

enum ProductKind {
  EQUIPMENT // a unit from the EquipmentModel catalog
  CONSUMABLE // a filter or other consumable
  OTHER // off-catalog item (free text)
}

model Order {
  id               String          @id @default(cuid())
  /// Auto-generated `SO{YYMMDD}-{seq:03d}`.
  orderNumber      String          @unique
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Optional link to a specific Equipment row — used for "이 장비를 위해
  /// 주문한 소모품" surfacing on the equipment-detail purchase-history widget.
  equipmentId      String?
  equipment        Equipment?      @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  siteId           String?
  site             Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  /// Optional link to a Contract when the order is part of a contract
  /// fulfilment (initial install, scheduled replacement). Not required —
  /// off-contract sales are common.
  contractId       String?
  contract         Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  /// Delivery / installation visit the office scheduled at order creation.
  /// Every order created via /api/orders POST gets a SUGGESTED visit so
  /// the field tech sees the work on their queue; null only for orders
  /// imported from legacy data or backfilled before this rollout.
  visitId          String?
  visit            Visit?          @relation("OrderVisit", fields: [visitId], references: [id], onDelete: SetNull)
  /// Origin link: the order was raised from a ServiceRequest the customer
  /// submitted. Set when the office uses the [+ 주문 등록] CTA on the SR
  /// detail page. Optional — most orders are direct office entries.
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation("OrderServiceRequest", fields: [serviceRequestId], references: [id], onDelete: SetNull)
  orderedAt        DateTime
  deliveredAt      DateTime?
  state            OrderState      @default(PENDING)
  notes            String?
  createdById      String?
  createdBy        User?           @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items OrderItem[]

  @@index([customerId, orderedAt])
  @@index([equipmentId])
  @@index([state])
  @@index([visitId])
  @@index([serviceRequestId])
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productKind      ProductKind
  /// Set when productKind=CONSUMABLE. Mutually exclusive with
  /// equipmentModelId + customName (validator-enforced).
  consumableId     String?
  consumable       Consumable?     @relation(fields: [consumableId], references: [id], onDelete: SetNull)
  /// Set when productKind=EQUIPMENT.
  equipmentModelId String?
  equipmentModel   EquipmentModel? @relation(fields: [equipmentModelId], references: [id], onDelete: SetNull)
  /// Set when productKind=OTHER (off-catalog free text).
  customName       String?
  /// Optional per-item link to a specific installed Equipment row so
  /// the office can say "this filter is for THAT purifier". Drives the
  /// per-line consumable-picker filter in the order-create modal (the
  /// dropdown shows only consumables compatible with this device's
  /// model) and lets the equipment-detail page surface which orders
  /// were logged against it.
  equipmentId      String?
  equipment        Equipment?      @relation("OrderItemEquipment", fields: [equipmentId], references: [id], onDelete: SetNull)
  quantity         Int
  unitPrice        Decimal         @db.Decimal(14, 2)
  totalPrice       Decimal         @db.Decimal(14, 2)
  /// Free-text purpose (e.g. "교체용", "유지보수", "관리용").
  purpose          String?
  notes            String?

  @@index([orderId])
  @@index([consumableId])
  @@index([equipmentModelId])
  @@index([equipmentId])
}

// ─────────────────────────────────────────────────────────────────────────
// INVENTORY LEDGER (added 2026-08)
//
// StockMove is the append-only history-of-record for every stock change on a
// product (EquipmentModel) or consumable (Consumable). EquipmentModel.stockOnHand
// / Consumable.stockOnHand are cached counters kept in sync in the SAME
// transaction as each move. Negative on-hand is allowed — the field surfaces it
// as a low-stock alert, it never blocks an install/replacement/order.
//
// Moves are created by:
//   - Manual 입고/출고/조정 via POST /api/inventory/moves (MANAGER+)
//   - Auto OUT on equipment install (INSTALL), filter replacement
//     (FILTER_REPLACE), and order delivery (SALE)
// ─────────────────────────────────────────────────────────────────────────
enum StockItemKind {
  MODEL
  CONSUMABLE
}

enum StockDirection {
  IN
  OUT
}

enum StockMoveReason {
  PURCHASE // inbound purchase (IN)
  SALE // order delivery to customer (OUT)
  INSTALL // equipment installed at a site (OUT)
  FILTER_REPLACE // consumable used on a service visit (OUT)
  ADJUST // manual correction to a target quantity (IN or OUT)
  RETURN // returned to stock (IN)
}

model StockMove {
  id               String          @id @default(cuid())
  itemKind         StockItemKind
  equipmentModelId String?
  equipmentModel   EquipmentModel? @relation("StockMoveModel", fields: [equipmentModelId], references: [id], onDelete: Cascade)
  consumableId     String?
  consumable       Consumable?     @relation("StockMoveConsumable", fields: [consumableId], references: [id], onDelete: Cascade)
  direction        StockDirection
  quantity         Int
  reason           StockMoveReason
  unitPrice        Decimal?        @db.Decimal(14, 2)
  /// Origin link back to what caused an automatic move ("ORDER"/"VISIT"/
  /// "EQUIPMENT" + row id). Null for manual moves.
  sourceType       String?
  sourceId         String?
  note             String?
  createdById      String?
  createdBy        User?           @relation("StockMoveCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([equipmentModelId, createdAt])
  @@index([consumableId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// EQUIPMENT CONSUMABLE OVERRIDE (added 2026-06)
//
// Two responsibilities in one table:
//
//   1. Per-unit cycle override — office staff can force a different
//      `replaceEveryDays` for a given (equipment × consumable) pair
//      when the standard model-level cycle doesn't fit (heavy-use
//      restaurant, water hardness, customer request, etc.).
//
//   2. Manually-added consumables — a filter that isn't in the
//      catalog-defined `ConsumableOnModel` for the equipment's model.
//      Either by linking an existing Consumable that just isn't on the
//      model's standard parts list, or via `customName` for an
//      off-catalog filter the office types in free-text.
//
// Resolution order for the filter-history view:
//   - Standard parts = EquipmentModel.consumables (ConsumableOnModel)
//   - Plus every EquipmentConsumable row for this equipment
//   - Cycle: EquipmentConsumable.replaceEveryDays > Consumable.replaceEveryDays
// ─────────────────────────────────────────────────────────────────────────
model EquipmentConsumable {
  id                     String      @id @default(cuid())
  equipmentId            String
  equipment              Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  /// Catalog filter (preferred). Mutually exclusive with `customName`.
  consumableId           String?
  consumable             Consumable? @relation(fields: [consumableId], references: [id], onDelete: SetNull)
  /// Off-catalog filter description (e.g. "타사 RO 멤브레인 호환"). Used
  /// when consumableId is null. Required in that case (enforced in the
  /// validator).
  customName             String?
  quantity               Int         @default(1)
  /// Override cycle in days. When null, falls back to the catalog
  /// consumable's `replaceEveryDays`. For manual filters with
  /// customName, this is the authoritative cycle.
  replaceEveryDays       Int?
  /// Admin override for this filter's "최근 교체일" (last replacement date).
  /// Normally derived from the latest REPLACE VisitConsumableLog; this lets
  /// MANAGER+ correct an error or seed pre-system history. When set it
  /// becomes the next-due anchor for this filter.
  lastReplacedAtOverride DateTime?
  /// Admin override for this filter's "다음 교체 예정일". Normally derived
  /// (anchor + cycle); when set it takes precedence and drives the D-day
  /// directly. Inline-editable in the service-config table.
  nextReplaceAtOverride  DateTime?
  unitPrice              Decimal?    @db.Decimal(14, 2)
  notes                  String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([equipmentId])
  @@index([consumableId])
}

// ─────────────────────────────────────────────────────────────────────────
// CONTRACTS (Phase 3)
// ─────────────────────────────────────────────────────────────────────────

enum ContractType {
  SALE
  RENTAL
  MAINTENANCE
}

enum ContractState {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  AMENDED
  COMPLETED // rental term ended naturally
  TERMINATED // early termination
  CANCELLED // never activated
}

/// RENTAL contracts only — what happens to the leased equipment when the
/// rental term ends naturally. Default = transfer to customer (current
/// historical behavior). Setting RETRIEVE_DEVICE means the cron skips the
/// ownership flip and auto-creates a RETRIEVAL visit at term end.
enum EndOfTermAction {
  TRANSFER_OWNERSHIP
  RETRIEVE_DEVICE
}

model Contract {
  id                   String        @id @default(cuid())
  contractNumber       String        @unique // HD-YYYYmmDD/SA-KH#### or HD-YYYYmmDD/SA-{shortcode}
  legacyContractNumber String?       @unique
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type                 ContractType
  state                ContractState @default(DRAFT)

  startDate  DateTime?
  endDate    DateTime? // rental: start + 36 months
  termMonths Int? // for rental

  monthlyMaintenanceFee Decimal?         @db.Decimal(14, 2)
  totalContractValue    Decimal?         @db.Decimal(14, 2)
  /// RENTAL: deposit collected up-front at the installation visit and
  /// refundable on early termination per business rules. Null for SALE /
  /// MAINTENANCE.
  deposit               Decimal?         @db.Decimal(14, 2)
  /// RENTAL only: what happens at end-of-term (TRANSFER_OWNERSHIP or
  /// RETRIEVE_DEVICE). Defaults to TRANSFER_OWNERSHIP for back-compat.
  endOfTermAction       EndOfTermAction? @default(TRANSFER_OWNERSHIP)
  filterPolicy          Json? // override of EquipmentModel.filterPolicy

  // B2B amendment chain (B.2 + B.5)
  parentContractId  String?
  parentContract    Contract?  @relation("ContractAmendment", fields: [parentContractId], references: [id])
  amendments        Contract[] @relation("ContractAmendment")
  amendmentRevision Int        @default(0)
  amendmentReason   String?

  /// Free-text memo printed on the contract PDF (요청 #4). Editable on DRAFT
  /// and ACTIVE contracts via PATCH; the contract renderer prints it in a
  /// dedicated notes section when non-empty.
  notes String?

  signedByCustomerAt      DateTime?
  signedByCompanyAt       DateTime?
  activatedAt             DateTime?
  terminatedAt            DateTime?
  terminationReason       String?
  /// Refund returned to customer at early termination (recorded for audit
  /// alongside any DEPOSIT_REFUND payment row generated).
  terminationRefundAmount Decimal?  @db.Decimal(14, 2)

  /// In-place RENTAL→SALE conversion bookkeeping. When set, the contract's
  /// current `type` reflects the post-conversion shape; `convertedFromType`
  /// preserves the pre-conversion type for audit/UI surfacing.
  convertedFromType ContractType?
  convertedAt       DateTime?

  /// Manually-uploaded signed contract PDF — takes precedence over the
  /// auto-rendered contract PDF when present.
  pdfStorageKey String?
  pdfUploadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment ContractEquipment[]
  payments  Payment[]
  documents Document[]
  /// Visits auto-spawned by the contract lifecycle (RETRIEVAL at end of
  /// term, plus future INSTALLATION wiring). Optional on Visit so existing
  /// historical visits stay valid.
  visits    Visit[]
  orders    Order[]

  @@index([customerId, state])
  @@index([state])
  @@index([parentContractId])
  @@index([endDate])
}

model ContractEquipment {
  id          String    @id @default(cuid())
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  unitPrice   Decimal?  @db.Decimal(14, 2)
  quantity    Int       @default(1)
  notes       String?
  createdAt   DateTime  @default(now())

  // ── Per-equipment pause tracking (added 2026-06) ──────────────────
  // Policy: the Contract document (endDate, totalContractValue, monthly
  // fee) is IMMUTABLE. When an Equipment is DEACTIVATED its rental /
  // maintenance billing is paused pro-rata, and the per-equipment
  // settlement (retrieval OR ownership-transfer) is pushed back by the
  // exact paused duration. Each ContractEquipment row carries its own
  // pause ledger, so device A and device B in the same contract can
  // settle on different dates.
  /// Days this line has been paused (DEACTIVATED) within this contract,
  /// rolled up at each reactivation. Used by the billing pro-rata logic
  /// and the per-equipment effectiveEndDate calculation.
  cumulativePausedDays  Int       @default(0)
  /// Set while the line is currently paused; null while billing is on.
  /// Reactivation rolls the elapsed days into cumulativePausedDays.
  currentPauseStartedAt DateTime?
  /// Per-equipment settlement timestamp — set when this specific line
  /// reaches its effectiveEndDate (= contract.endDate + cumulativePausedDays)
  /// and the cron flips ownership / spawns a RETRIEVAL visit for it.
  /// Independent of sibling lines in the same contract.
  settledAt             DateTime?

  @@unique([contractId, equipmentId])
  @@index([equipmentId])
  @@index([currentPauseStartedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// SERVICE REQUEST (Phase 5)
// ─────────────────────────────────────────────────────────────────────────

enum ServiceRequestType {
  INSPECTION
  REPAIR
  PART_REPLACEMENT
  RELOCATION
  OTHER
}

enum ServiceRequestState {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

model ServiceRequest {
  id               String              @id @default(cuid())
  code             String              @unique // SR-####
  customerId       String
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Optional site picker (added 2026-06). Multi-site customers can
  /// specify which site the request belongs to; B2C / single-site
  /// customers leave it null. Always nullable — the customer may not
  /// remember which site, and the office will reconcile later.
  siteId           String?
  site             Site?               @relation(fields: [siteId], references: [id], onDelete: SetNull)
  contactId        String?
  contact          CustomerContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  equipmentId      String?
  equipment        Equipment?          @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  type             ServiceRequestType
  isPaid           Boolean             @default(false)
  state            ServiceRequestState @default(PENDING_REVIEW)
  description      String
  attachments      Json? // [{ url, filename, type }]
  // Customer's preferred visit time captured at submission. Office uses
  // it to pre-fill the approval modal's scheduledFor and to know when to
  // call the customer to negotiate a different slot.
  preferredVisitAt DateTime?
  approvedPrice    Decimal?            @db.Decimal(14, 2)
  approvedDate     DateTime?
  rejectionReason  String?
  submittedAt      DateTime            @default(now())
  decidedAt        DateTime?
  decidedById      String?
  // Team-wide "last read" marker for the office side of the customer
  // message thread. Any office user (ADMIN / MANAGER / STAFF) hitting
  // the mark-read endpoint advances this for everyone, so the unread
  // badge is consistent across the team. Comparing against the max
  // timestamp of AuditLog rows where action='SR_MESSAGE' AND
  // actorType='CUSTOMER' for this SR tells us if there are new
  // customer messages to surface.
  lastOfficeReadAt DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  visit  Visit?
  /// Orders raised from this service request (office uses the
  /// [+ 주문 등록] CTA on SR detail). Usually 0..1.
  orders Order[] @relation("OrderServiceRequest")

  @@index([customerId, state])
  @@index([state, submittedAt])
  @@index([siteId])
}

// ─────────────────────────────────────────────────────────────────────────
// VISIT (Phase 4)
// ─────────────────────────────────────────────────────────────────────────

enum VisitState {
  SUGGESTED // scheduler proposed
  SCHEDULED // office confirmed
  IN_PROGRESS // technician opened on mobile
  COMPLETED // lead tech marked done
  FAILED_NO_SHOW
  RESCHEDULED
  CANCELLED
}

enum VisitType {
  INSTALLATION
  PERIODIC_INSPECTION
  REPAIR
  FILTER_REPLACEMENT
  RELOCATION
  PAYMENT_COLLECTION
  /// End-of-rental device recovery — auto-spawned by the contract cron when
  /// a RENTAL contract with endOfTermAction=RETRIEVE_DEVICE reaches its end
  /// date, or by a mid-term cancellation flagged for retrieval.
  RETRIEVAL
  /// Consumable / spare-part delivery raised via a customer purchase
  /// order. Piggy-backs on an upcoming visit (added to `additionalTypes`)
  /// or spawns a fresh delivery-only visit — see POST /api/orders.
  CONSUMABLE_DELIVERY
  OTHER
}

model Visit {
  id                   String          @id @default(cuid())
  customerId           String
  customer             Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  siteId               String?
  /// Site relation — added 2026-06 so multi-site B2B visits can be
  /// grouped + filtered by location. SetNull preserves visit history if
  /// the site is later removed.
  site                 Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  equipmentId          String?
  equipment            Equipment?      @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  /// Set when the visit was auto-spawned by a contract lifecycle event
  /// (RETRIEVAL at end-of-term, or potential future INSTALLATION wiring).
  /// Optional + onDelete: SetNull so the contract can be soft-purged without
  /// losing visit history.
  contractId           String?
  contract             Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  serviceRequestId     String?         @unique
  serviceRequest       ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  type                 VisitType
  /// Secondary visit types layered on top of `type` — a single field
  /// visit may cover multiple work streams (e.g. a scheduled inspection
  /// where the tech also drops off a consumable order the customer paid
  /// for). Empty when the visit only does its primary `type` work. See
  /// POST /api/orders "attachToVisitId" flow for the canonical use case.
  additionalTypes      VisitType[]     @default([])
  /// Document kinds queued to auto-issue when this visit becomes
  /// SCHEDULED (or immediately if it already is). Populated by POST
  /// /api/orders — consumable orders drop the customer-appropriate
  /// delivery kind (DELIVERY_RECEIPT for B2C, DELIVERY_SLIP_B2B for
  /// B2B) here. Each kind is removed from the array as its PDF is
  /// rendered by `VisitWorkflow.schedule` so the field stays a live
  /// worklist rather than an audit trail.
  pendingDocumentKinds DocumentKind[]  @default([])
  state                VisitState      @default(SUGGESTED)

  scheduledFor DateTime

  leadTechnicianId          String?
  leadTechnician            User?    @relation("LeadTechnician", fields: [leadTechnicianId], references: [id], onDelete: SetNull)
  collaboratorTechnicianIds String[] @default([])

  expectedAmount            Decimal? @db.Decimal(14, 2)
  findings                  String?
  partsReplaced             Json?
  photos                    Json? // [{ url, takenAt }]
  // Technician → HQ relay thread. Technicians never contact customers directly,
  // so customer phone numbers are hidden in the field; instead the technician
  // leaves handoff messages here for the office. NOT shown on customer-facing
  // documents (the work-confirmation PDF only renders `findings`).
  officeNotes               Json? // [{ at, authorId, authorName, text }]
  customerSignaturePhotoUrl String?

  startedAt     DateTime?
  completedAt   DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments       Payment[]
  documents      Document[]
  consumableLogs VisitConsumableLog[]
  /// Orders whose delivery/install is fulfilled by this visit. Usually
  /// 0..1 — one order per visit — but the join is many-to-one to allow
  /// merging two same-customer orders onto a single trip when needed.
  orders         Order[]              @relation("OrderVisit")

  @@index([leadTechnicianId, state])
  @@index([customerId, state])
  @@index([scheduledFor])
  @@index([state, scheduledFor])
  @@index([contractId])
}

// ─────────────────────────────────────────────────────────────────────────
// PAYMENT (Phase 6)
// ─────────────────────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentState {
  EXPECTED // invoice issued, awaiting payment
  COLLECTED // technician collected cash
  HANDED_OVER // tech deposited at office
  RECONCILED // manager approved final
  OVERDUE_D7
  OVERDUE_D14
  OVERDUE_D30
  WRITTEN_OFF
}

/// What this payment row represents in the contract's financial story.
/// Drives the per-contract payment history view + reporting aggregates.
/// Defaults to RENTAL_FEE so legacy rows remain interpretable.
enum PaymentKind {
  DEPOSIT // RENTAL up-front deposit (refundable)
  RENTAL_FEE // RENTAL monthly fee
  SALE_PAYMENT // SALE outright purchase or post-conversion balance
  MAINTENANCE_FEE // MAINTENANCE monthly/periodic fee
  SERVICE_FEE // ad-hoc paid service charge (out-of-warranty repairs)
  DEPOSIT_REFUND // refund returned at termination / RENTAL→SALE conversion
}

model Payment {
  id            String     @id @default(cuid())
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contractId    String?
  contract      Contract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  visitId       String?
  visit         Visit?     @relation(fields: [visitId], references: [id], onDelete: SetNull)
  /// Optional link to a specific Equipment row (added 2026-06).
  /// Technicians can mark "this payment is for THAT device" when a
  /// visit covers multiple units, so the office can audit which
  /// equipment a fee was collected against.
  equipmentId   String?
  equipment     Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  collectedById String? // technician
  collectedBy   User?      @relation(fields: [collectedById], references: [id], onDelete: SetNull)

  kind            PaymentKind   @default(RENTAL_FEE)
  method          PaymentMethod
  state           PaymentState  @default(EXPECTED)
  expectedAmount  Decimal       @db.Decimal(14, 2)
  actualAmount    Decimal       @default(0) @db.Decimal(14, 2)
  carryoverAmount Decimal       @default(0) @db.Decimal(14, 2) // D.3
  currency        String        @default("VND")
  reference       String? // bank transfer ref number

  collectedAt  DateTime?
  handedOverAt DateTime?
  reconciledAt DateTime?

  dueDate DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxInvoice TaxInvoice?
  documents  Document[]

  @@index([customerId, state])
  @@index([contractId, kind])
  @@index([state, dueDate])
  @@index([collectedById])
  @@index([equipmentId])
}

// ─────────────────────────────────────────────────────────────────────────
// TAX INVOICE (Phase 6)
// ─────────────────────────────────────────────────────────────────────────

enum InvoiceProvider {
  MANUAL_UPLOAD
  VIETTEL_SINVOICE // Phase 8+
}

model TaxInvoice {
  id                   String          @id @default(cuid())
  paymentId            String          @unique
  payment              Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceNumber        String?         @unique
  invoiceDate          DateTime?
  invoiceProvider      InvoiceProvider @default(MANUAL_UPLOAD)
  invoiceProviderRef   String?
  invoicePdfUploadedAt DateTime?
  pdfStorageKey        String?
  emailedAt            DateTime?
  emailedToContactId   String?
  reissuedFromId       String?
  notes                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([invoiceNumber])
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS (Phase 3.5+)
// ─────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  MOCKED // mock provider used
  SKIPPED // recipient opted out + non-system message
}

model NotificationLog {
  id                String              @id @default(cuid())
  customerId        String?
  customer          Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           CustomerContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  templateCode      String // e.g. "SMS_VISIT_REMINDER"
  channel           NotificationChannel
  locale            Locale
  provider          String // "mock" / "esms" / "resend"
  recipient         String // phone or email
  payload           Json? // rendered body + subject + variables
  status            NotificationStatus  @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  segmentsUsed      Int? // SMS segments billed
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([customerId])
  @@index([contactId])
  @@index([templateCode, createdAt])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// DOCUMENT (PDF storage — Phase 3+)
// ─────────────────────────────────────────────────────────────────────────

enum DocumentKind {
  CONTRACT
  RECEIPT
  WORK_CONFIRMATION
  DELIVERY_SLIP // legacy alias — DELIVERY_SLIP_B2B is the new canonical kind (kept for back-compat)
  PERIODIC_INSPECTION // legacy alias — PERIODIC_CHECK_B2C / B2B are the new canonical kinds
  TAX_INVOICE
  // Phase 6+ visit-document expansion (2026-06-03):
  DELIVERY_RECEIPT // B2C rental — install + handover slip & receipt (DOCUMENT_TEMPLATES §4)
  SALE_RECEIPT_B2C // B2C sale — sale receipt + handover (§5)
  DELIVERY_SLIP_B2B // B2B install — Mẫu số 02-VT delivery slip (§3)
  PERIODIC_CHECK_B2C // B2C periodic — inspection + receipt (§6)
  PERIODIC_CHECK_B2B // B2B periodic — inspection confirmation (no prices, §7)
  OTHER
}

model Document {
  id              String       @id @default(cuid())
  kind            DocumentKind
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contractId      String?
  contract        Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
  visitId         String?
  visit           Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  paymentId       String?
  payment         Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  templateCode    String // e.g. "CONTRACT_B2C_RENTAL"
  locale          Locale       @default(vi) // primary language (always vi for bilingual docs)
  secondaryLocale Locale? // bilingual secondary language (ko default / en) — null for legacy single-locale docs
  storageKey      String // path under uploads/ (or future Supabase Storage)
  filename        String
  mimeType        String       @default("application/pdf")
  sizeBytes       Int?
  generatedAt     DateTime     @default(now())
  generatedById   String?

  @@index([customerId, kind])
  @@index([contractId])
  @@index([visitId])
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICATION TEMPLATES (Phase 7 — UC-AD-04 admin overrides)
// ─────────────────────────────────────────────────────────────────────────

/**
 * DB-backed overrides for SMS + email templates. Provider lookup checks this
 * table first (cached 60s in-memory) and falls back to the file-based
 * defaults in `src/lib/{sms,email}/templates.ts` when no row exists.
 * Composite unique key on (code, locale).
 */
model NotificationTemplate {
  id          String              @id @default(cuid())
  code        String // e.g. "SMS_VISIT_REMINDER"
  channel     NotificationChannel
  locale      Locale
  subject     String? // email only
  body        String
  /// Admin-controlled per-(code, locale) on/off switch. When false, the
  /// send pipeline records a SKIPPED log and the message is never dispatched.
  enabled     Boolean             @default(true)
  updatedAt   DateTime            @updatedAt
  updatedById String?
  createdAt   DateTime            @default(now())

  @@unique([code, locale])
  @@index([code])
}

// ─────────────────────────────────────────────────────────────────────────
// SYSTEM SETTINGS (Phase 7 — singleton key/value config)
// ─────────────────────────────────────────────────────────────────────────

/**
 * Generic key/value store for scheduler weights (UC-AD-05) and other
 * admin-tunable knobs. Values are JSON-typed so the same row can hold a
 * single number or a struct. Caller decodes per-key.
 */
model SystemSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
  createdAt   DateTime @default(now())
}

